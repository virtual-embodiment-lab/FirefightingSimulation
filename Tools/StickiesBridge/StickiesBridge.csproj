<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UDP to Bluetooth LE bridge for Sensorimotor Stickies feedback devices.
    Lets the Unity Editor (or a standalone Quest over Wi-Fi) drive Stickies with this PC's Bluetooth.
    How to run it: see README.md next to this file.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StickiesBridge</RootNamespace>
  </PropertyGroup>

</Project>
